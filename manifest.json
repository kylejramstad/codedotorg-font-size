{
  "manifest_version": 3,
  "name": "Code font-size",
  "version": "1.0",
  "description": "Adds font size buttons to Code.org and CMU.edu CS Academy projects",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": [
        "https://studio.code.org/*",
        "https://*.code.org/*",
        "https://academy.cs.cmu.edu/*",
        "https://*.pltw.org/*",
        "https://pltw.org/*",
        "https://*.thoughtindustries.com/*"
      ],
      "all_frames": true
    }
  ]
}